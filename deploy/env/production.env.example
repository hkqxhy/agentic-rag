# Copy to deploy/env/production.env on the ECS host. Never commit the real file.
# SITE_ADDRESS must resolve to the ECS public IP before Caddy can obtain TLS.
SITE_ADDRESS=assistant.example.edu.cn

POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg17-bookworm

# Generate independently, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
AGENTIC_RAG_AUDIT_HASH_KEY=replace-with-an-independent-long-random-key

# Initial capacity target: about 100 registered users, not 100 simultaneous generations.
QUESTION_RATE_LIMIT=10
QUESTION_RATE_WINDOW_SECONDS=60
IP_QUESTION_RATE_LIMIT=120
AUTH_RATE_LIMIT=60
AUTH_IDENTITY_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300

# Phase 2 Agentic RAG and Qwen-compatible model gateway.
AGENTIC_RAG_SOURCE_PATHS=knowledge/official
AGENTIC_RAG_INDEX_DIR=/app/runtime/index
AGENTIC_RAG_TOP_K=5
AGENTIC_RAG_CANDIDATE_K=40
AGENTIC_RAG_MIN_CONFIDENCE=0.16
AGENTIC_RAG_USE_CACHE=1
AGENTIC_RAG_USE_GRAPHRAG=1
AGENTIC_RAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTIC_RAG_LLM_MODEL=qwen-plus
AGENTIC_RAG_LLM_API_KEY=replace-with-your-model-studio-api-key
AGENTIC_RAG_LLM_TIMEOUT=30

AGENTIC_RAG_DENSE_RETRIEVAL_MODE=off
AGENTIC_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTIC_RAG_EMBEDDING_API_KEY=replace-with-your-model-studio-api-key
AGENTIC_RAG_EMBEDDING_MODEL=text-embedding-v4
AGENTIC_RAG_EMBEDDING_DIMENSIONS=1024
AGENTIC_RAG_EMBEDDING_VERSION=text-embedding-v4-1024-v1
AGENTIC_RAG_EMBEDDING_TIMEOUT_SECONDS=15
AGENTIC_RAG_DENSE_CANDIDATE_K=40
AGENTIC_RAG_DENSE_MIN_SIMILARITY=0.45
AGENTIC_RAG_DENSE_RRF_WEIGHT=1.0

AGENTIC_RAG_ALLOW_TEST_KNOWLEDGE=0
AGENTIC_RAG_KNOWLEDGE_MIN_DOCUMENTS=8
AGENTIC_RAG_KNOWLEDGE_MIN_CHUNKS=8
