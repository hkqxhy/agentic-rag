# Copy to deploy/env/staging.env on the ECS host. Never commit the real file.
# Use the ECS public IPv4 address and keep port 80 restricted in the security group.
STAGING_ORIGIN=http://203.0.113.10

# Docker Hub is unreliable from this mainland China staging host. These are
# anonymous public mirrors of the Docker Official Images in Amazon ECR Public.
# Mirror this pinned image to Alibaba Cloud ACR if Docker Hub is unreachable.
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg17-bookworm
REDIS_IMAGE=public.ecr.aws/docker/library/redis:8-alpine
CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2.10-alpine
PYTHON_BASE_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# Generate independently with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
AGENTIC_RAG_AUDIT_HASH_KEY=replace-with-an-independent-long-random-key

# Initial capacity target: about 100 registered users and 10-20 peak online users.
QUESTION_RATE_LIMIT=10
QUESTION_RATE_WINDOW_SECONDS=60
IP_QUESTION_RATE_LIMIT=120
AUTH_RATE_LIMIT=60
AUTH_IDENTITY_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300

# Phase 2 Agentic RAG. Keep the URL empty for the local extractive fallback.
AGENTIC_RAG_SOURCE_PATHS=knowledge/fixtures
AGENTIC_RAG_INDEX_DIR=/app/runtime/index
AGENTIC_RAG_TOP_K=5
AGENTIC_RAG_CANDIDATE_K=40
AGENTIC_RAG_MIN_CONFIDENCE=0.16
AGENTIC_RAG_USE_CACHE=1
AGENTIC_RAG_USE_GRAPHRAG=1

# Alibaba Cloud Model Studio OpenAI-compatible endpoint.
AGENTIC_RAG_LLM_BASE_URL=
AGENTIC_RAG_LLM_MODEL=qwen-plus
AGENTIC_RAG_LLM_API_KEY=EMPTY
AGENTIC_RAG_LLM_TIMEOUT=30

# Phase 3 dense retrieval. Start with shadow, ingest the index, validate, then use hybrid.
AGENTIC_RAG_DENSE_RETRIEVAL_MODE=off
AGENTIC_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTIC_RAG_EMBEDDING_API_KEY=EMPTY
AGENTIC_RAG_EMBEDDING_MODEL=text-embedding-v4
AGENTIC_RAG_EMBEDDING_DIMENSIONS=1024
AGENTIC_RAG_EMBEDDING_VERSION=text-embedding-v4-1024-v1
AGENTIC_RAG_EMBEDDING_TIMEOUT_SECONDS=15
AGENTIC_RAG_DENSE_CANDIDATE_K=40
AGENTIC_RAG_DENSE_MIN_SIMILARITY=0.45
AGENTIC_RAG_DENSE_RRF_WEIGHT=1.0
