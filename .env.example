# Copy this file to .env.local and fill in local values.
# Never commit .env.local or a real API key.

# Knowledge sources. Separate multiple paths with ';' on Windows or ':' on Linux.
PAIMON_SOURCE_PATHS=knowledge/fixtures
PAIMON_INDEX_DIR=.paimon_index
PAIMON_TOP_K=5
PAIMON_CANDIDATE_K=40
PAIMON_MIN_CONFIDENCE=0.16
PAIMON_USE_CACHE=1
PAIMON_USE_GRAPHRAG=1

# OpenAI-compatible model gateway. Leave the URL empty to use extractive fallback mode.
PAIMON_LLM_BASE_URL=
PAIMON_LLM_MODEL=qwen-plus
PAIMON_LLM_API_KEY=replace-with-your-local-secret
PAIMON_LLM_TIMEOUT=30
