# Copy this file to .env.local and fill in local values.
# Never commit .env.local or a real API key.

# Phase 1 service runtime.
AGENTIC_RAG_ENVIRONMENT=development
AGENTIC_RAG_LOG_LEVEL=INFO
AGENTIC_RAG_DATABASE_URL=postgresql+asyncpg://agentic_rag:agentic_rag@localhost:5432/agentic_rag
AGENTIC_RAG_REDIS_URL=redis://localhost:6379/0
AGENTIC_RAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENTIC_RAG_RUN_QUEUE_KEY=agentic_rag:runs:queue
AGENTIC_RAG_RUN_STREAM_PREFIX=agentic_rag:runs:events
AGENTIC_RAG_RUN_EVENT_TTL_SECONDS=86400
AGENTIC_RAG_OTEL_ENABLED=false
AGENTIC_RAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Browser-side API address. It contains no secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# V1 baseline knowledge sources. Separate paths with ';' on Windows or ':' on Linux.
AGENTIC_RAG_SOURCE_PATHS=knowledge/fixtures
AGENTIC_RAG_INDEX_DIR=.agentic_rag_v1_index
AGENTIC_RAG_TOP_K=5
AGENTIC_RAG_CANDIDATE_K=40
AGENTIC_RAG_MIN_CONFIDENCE=0.16
AGENTIC_RAG_USE_CACHE=1
AGENTIC_RAG_USE_GRAPHRAG=1

# OpenAI-compatible model gateway. Leave the URL empty to use extractive fallback mode.
AGENTIC_RAG_LLM_BASE_URL=
AGENTIC_RAG_LLM_MODEL=qwen-plus
AGENTIC_RAG_LLM_API_KEY=replace-with-your-local-secret
AGENTIC_RAG_LLM_TIMEOUT=30
