{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-rag.example/schemas/document-manifest.schema.json",
  "title": "Agentic RAG knowledge document manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "version",
    "title",
    "source_uri",
    "source_type",
    "authority_level",
    "status",
    "sensitivity",
    "checksum",
    "last_verified_at"
  ],
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_uri": { "type": "string", "minLength": 1 },
    "source_type": {
      "enum": ["official", "maintained", "community", "opinion", "fixture"]
    },
    "authority_level": {
      "enum": ["official", "maintained", "community", "opinion", "fixture"]
    },
    "campus": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "audience": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "category": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "academic_year": { "type": ["string", "null"] },
    "effective_from": { "type": ["string", "null"], "format": "date" },
    "effective_to": { "type": ["string", "null"], "format": "date" },
    "status": { "enum": ["draft", "active", "stale", "archived", "rejected", "test_only"] },
    "owner": { "type": ["string", "null"] },
    "reviewer": { "type": ["string", "null"] },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "sensitivity": { "enum": ["public", "internal", "restricted"] },
    "license_or_permission": { "type": ["string", "null"] },
    "checksum": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "parser_version": { "type": ["string", "null"] },
    "embedding_version": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
